# Copy to .env and fill in. Never commit real secrets.
PORT=4000
AI_SERVICE_URL=http://127.0.0.1:8001
# Optional in local development; when unset the API runs in-memory.
# Production REQUIRES durable Mongo: registration, profile updates, and
# assignment mutations fail closed with 503 when it is unavailable.
MONGODB_URI=
# Per-client in-memory rate limit (not Redis-backed).
RATE_LIMIT_PER_MIN=60
# Express trust-proxy setting. Default "loopback" is correct for host Caddy
# proxying to 127.0.0.1:4000. Set a hop count or subnet if the proxy reaches
# the API from a Docker bridge/another host; "false"/"0" disables it.
TRUST_PROXY=loopback
# Phase 9: auth (open dev mode unless AUTH_REQUIRED=1).
# WARNING: this placeholder is rejected when AUTH_REQUIRED=1 (server refuses to boot).
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
AUTH_REQUIRED=0
# Session cookie transport: SameSite=Lax locally; cross-site production
# (Vercel -> API) needs COOKIE_SECURE=1 (SameSite=None + Secure over HTTPS).
# The API itself must be served over HTTPS or browsers drop the cookie.
COOKIE_SECURE=0
# CORS: comma-separated frontend origins allowed to call the API with
# credentials (e.g. ALLOWED_ORIGINS=https://marklyai.vercel.app).
# Empty = reflect any origin outside production. In production
# (NODE_ENV=production) an empty allowlist FAILS CLOSED for browser origins;
# set this explicitly before deploying. Non-browser callers (curl, health
# checks) always pass.
ALLOWED_ORIGINS=
# Phase 9: background jobs via BullMQ (in-process queue unless BOTH are set).
# Job status/progress remains process-local even with BullMQ.
REDIS_URL=
BULLMQ_ENABLED=0
# Phase 4: PDF compile command ({dir} holds doc.tex, {wslDir} is the WSL path).
# Default uses native docker and includes -no-shell-escape. Saved LaTeX
# overrides are untrusted input, so any custom command MUST also disable TeX
# shell-escape. On Windows with Docker inside WSL set:
# PDF_COMPILE_CMD=wsl docker run --rm -v "{wslDir}:/work" -w /work texlive/texlive:latest pdflatex -no-shell-escape -interaction=nonstopmode -halt-on-error doc.tex
PDF_COMPILE_CMD=
# Optional overrides for the preflight check (docker binary + image to inspect).
# PDF_DOCKER=wsl docker
# PDF_IMAGE=texlive/texlive:latest
