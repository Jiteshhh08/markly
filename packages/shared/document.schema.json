{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markly.local/schemas/document/v2.json",
  "title": "AssignmentDocument",
  "description": "STAGE 5 canonical editable document. Academic content is an opaque snapshot validated by assignment.schema.json; blocks are the ordered, validated visual body. Template/layout identity stays separate and is never overwritten by the studio. This schema deliberately has no Qwen/Pydantic generation fields.",
  "type": "object",
  "required": [
    "schemaVersion",
    "assignmentId",
    "content",
    "template",
    "layout",
    "presentation",
    "blocks",
    "revision",
    "normalization"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "assignmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ownerUserId": { "type": ["string", "null"], "maxLength": 128 },
    "collegeId": { "type": ["string", "null"], "maxLength": 128 },
    "branchId": { "type": ["string", "null"], "maxLength": 128 },
    "content": {
      "type": ["object", "null"],
      "description": "Opaque academic-content snapshot. Validated by the independent assignment.schema.json, never by this document/layout schema."
    },
    "template": {
      "type": ["object", "null"],
      "description": "Template identity/ownership snapshot. Null means the legacy record had no usable snapshot; no id/version is invented.",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": ["integer", "null"], "minimum": 1 },
        "name": { "type": ["string", "null"], "maxLength": 200 },
        "scope": { "enum": ["platform", "college", "private", "legacy"] },
        "collegeId": { "type": ["string", "null"], "maxLength": 128 },
        "branchId": { "type": ["string", "null"], "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": ["object", "null"],
      "description": "Explicit template layout snapshot. Missing template data stays null; defaults are never invented during normalization.",
      "properties": {
        "page": { "type": ["object", "null"] },
        "typography": { "type": ["object", "null"] },
        "header": { "type": ["object", "null"] },
        "footer": { "type": ["object", "null"] },
        "watermark": { "type": ["object", "null"] },
        "facultyTable": { "type": ["object", "null"] },
        "assets": { "type": ["object", "null"] },
        "requiredSections": { "type": "array", "items": { "type": "string" } },
        "studentMetadataFields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["includeVivaTitle", "typedConclusion"],
      "properties": {
        "includeVivaTitle": { "type": "boolean" },
        "typedConclusion": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "maxItems": 500,
      "description": "Ordered student-editable body. Template-locked headers/watermarks stay in `layout`, never in this array.",
      "items": {
        "type": "object",
        "required": ["id", "type", "content"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "type": {
            "enum": [
              "title",
              "experimentNumber",
              "heading",
              "subheading",
              "paragraph",
              "bulletList",
              "numberedList",
              "code",
              "spacer",
              "pageBreak"
            ]
          },
          "content": {
            "type": "object",
            "description": "Type-specific content: text for text blocks, items for lists, text/language for code, height for spacer, empty for pageBreak."
          },
          "style": {
            "type": "object",
            "properties": {
              "align": { "enum": ["left", "center", "right", "justify"] },
              "fontSize": { "type": "integer", "minimum": 8, "maximum": 48 },
              "spacingBefore": { "type": "integer", "minimum": 0, "maximum": 120 },
              "spacingAfter": { "type": "integer", "minimum": 0, "maximum": 120 },
              "indent": { "type": "integer", "minimum": 0, "maximum": 120 }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "description": "Generated-block provenance. Regeneration replaces only blocks with a matching source.section.",
            "properties": {
              "section": {
                "enum": ["title", "experimentNumber", "aim", "objectives", "theory", "steps", "conclusion"]
              },
              "stepNumber": { "type": "integer", "minimum": 1, "maximum": 999 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "revision": { "type": "integer", "minimum": 0 },
    "documentUpdatedAt": { "type": ["string", "null"] },
    "normalization": {
      "type": "object",
      "required": [
        "source",
        "legacy",
        "missingContent",
        "missingTemplate",
        "missingLayout"
      ],
      "properties": {
        "source": { "enum": ["current", "legacy", "unknown"] },
        "legacy": { "type": "boolean" },
        "missingContent": { "type": "boolean" },
        "missingTemplate": { "type": "boolean" },
        "missingVersion": { "type": "boolean" },
        "missingLayout": { "type": "boolean" },
        "missingBlocks": { "type": "boolean" },
        "defaultsApplied": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
